        function Dialog:Close()
            if Dialog.Closed then return end
            Dialog.Closed = true
            if ActiveDialog == Dialog then ActiveDialog = nil end
            for _, Connection in ipairs(Connections) do Connection:Disconnect() end
            local Info = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            TweenService:Create(Card, Info, {GroupTransparency = 1}):Play()
            TweenService:Create(CardScale, Info, {Scale = 0.96}):Play()
            local FadeOut = TweenService:Create(Backdrop, Info, {BackgroundTransparency = 1})
            FadeOut:Play()
            FadeOut.Completed:Connect(function() Backdrop:Destroy() end)
            if type(Data.OnClose) == "function" then Library:SafeCall(Data.OnClose) end
        end

        TableInsert(Connections, CloseButton.MouseButton1Click:Connect(function() Dialog:Close() end))
        TableInsert(Connections, Backdrop.MouseButton1Click:Connect(function()
