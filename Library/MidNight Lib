    -- ================= TOASTS =================
    -- small pill at the top centre (or bottom centre), newest on top. Library:Toast and Window:Toast are the same.
    local ToastHolders = {}
    local ToastCount = 0
    local TOAST_MAX_W = 320

    local function GetToastHolder(Position)
        if ToastHolders[Position] and ToastHolders[Position].Parent then return ToastHolders[Position] end
        local IsBottom = Position == "Bottom"
        local Holder = InstanceNew("Frame")
        Holder.Name = "Toasts" .. Position
        Holder.BackgroundTransparency = 1
        Holder.AnchorPoint = Vector2New(0.5, IsBottom and 1 or 0)
        Holder.Position = IsBottom and UDim2New(0.5, 0, 1, -24) or UDim2New(0.5, 0, 0, 66)
        Holder.Size = UDim2New(0, TOAST_MAX_W, 1, -120)
        Holder.ZIndex = 999999
        local Layout = InstanceNew("UIListLayout")
        Layout.Padding = UDimNew(0, 8)
        Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        Layout.VerticalAlignment = IsBottom and Enum.VerticalAlignment.Bottom or Enum.VerticalAlignment.Top
        Layout.SortOrder = Enum.SortOrder.LayoutOrder
        Layout.Parent = Holder
        Holder.Parent = Library.Holder.Instance
        ToastHolders[Position] = Holder
        return Holder
    end

    function Library:Toast(Props)
        if type(Props) == "string" then Props = {title = Props} end
        Props = Props or {}
        local function Get(Key)
            local V = Props[Key]
            if V == nil then V = Props[Key:sub(1, 1):upper() .. Key:sub(2)] end
            return V
        end
        local TitleText = tostring(Get("title") or "")
        local SubText = Get("subtitle") and tostring(Get("subtitle")) or nil
        if SubText == "" then SubText = nil end
        local SubAbove = Get("subtitleAbove") == true
        local IconValue, Avatar = Get("icon"), tonumber(Get("avatar"))
        local MinWidth = math.min(tonumber(Get("minWidth")) or 0, TOAST_MAX_W)
        local Position = tostring(Get("position") or "Top") == "Bottom" and "Bottom" or "Top"
        local Duration = tonumber(Get("duration"))
        if not Duration then
            -- based on the text length, between 3 and 9 seconds
            Duration = math.clamp(2.5 + (#TitleText + #(SubText or "")) * 0.06, 3, 9)
        end

        local IsBottom = Position == "Bottom"
        local Image = Avatar and ("rbxthumb://type=AvatarHeadShot&id=" .. Avatar .. "&w=60&h=60")
            or (IconValue ~= nil and (Library:GetIcon(IconValue) or (type(IconValue) == "string" and IconValue))) or nil
        local Height = SubText and 50 or 40
        local Side = Image and (Avatar and 30 or 20) or 0
        local PadLeft = Image and (Avatar and 10 or 16) or 20

        ToastCount += 1
        local Slot = InstanceNew("Frame")
        Slot.BackgroundTransparency = 1
        Slot.Size = UDim2New(1, 0, 0, 0)
        Slot.LayoutOrder = -ToastCount
        Slot.ZIndex = 999999

        local Pill = InstanceNew("Frame")
        Pill.AnchorPoint = Vector2New(0.5, IsBottom and 1 or 0)
        Pill.Position = UDim2New(0.5, 0, IsBottom and 1 or 0, IsBottom and 14 or -14)
        Pill.Size = UDim2New(0, TOAST_MAX_W, 0, Height)
        Pill.BackgroundColor3 = Library.Theme.Background
        Pill.BackgroundTransparency = 1
        Pill.ZIndex = 1000000
        Pill.Parent = Slot
        Library:AddToTheme(Pill, {BackgroundColor3 = "Background"})
        local Corner = InstanceNew("UICorner")
        Corner.CornerRadius = UDimNew(1, 0)
        Corner.Parent = Pill
        local Stroke = InstanceNew("UIStroke")
        Stroke.Color = Library.Theme.Outline
        Stroke.Transparency = 1
        Stroke.Parent = Pill
        Library:AddToTheme(Stroke, {Color = "Outline"})
        local Pad = InstanceNew("UIPadding")
        Pad.PaddingLeft = UDimNew(0, PadLeft)
        Pad.PaddingRight = UDimNew(0, 22)
        Pad.Parent = Pill
        local Row = InstanceNew("UIListLayout")
        Row.FillDirection = Enum.FillDirection.Horizontal
        Row.VerticalAlignment = Enum.VerticalAlignment.Center
        Row.HorizontalAlignment = Enum.HorizontalAlignment.Center
        Row.Padding = UDimNew(0, 10)
        Row.SortOrder = Enum.SortOrder.LayoutOrder
        Row.Parent = Pill

        local Faders = {}
        local IconLabel
        if Image then
            IconLabel = InstanceNew("ImageLabel")
            IconLabel.LayoutOrder = 1
            IconLabel.Size = UDim2New(0, Side, 0, Side)
            IconLabel.BackgroundTransparency = 1
            IconLabel.Image = Image
            IconLabel.ImageTransparency = 1
            IconLabel.ScaleType = Avatar and Enum.ScaleType.Crop or Enum.ScaleType.Fit
            IconLabel.ZIndex = 1000001
            if Avatar then
                local C = InstanceNew("UICorner")
                C.CornerRadius = UDimNew(1, 0)
                C.Parent = IconLabel
            else
                IconLabel.ImageColor3 = Library.Theme.Text
                Library:AddToTheme(IconLabel, {ImageColor3 = "Text"})
            end
            IconLabel.Parent = Pill
        end

        local TextWidth = TOAST_MAX_W - PadLeft - 22 - (Image and (Side + 10) or 0)
        local Column = InstanceNew("Frame")
        Column.LayoutOrder = 2
        Column.BackgroundTransparency = 1
        Column.Size = UDim2New(0, TextWidth, 0, SubText and 34 or 18)
        Column.ZIndex = 1000001
        Column.Parent = Pill
        local ColLayout = InstanceNew("UIListLayout")
        ColLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ColLayout.Padding = UDimNew(0, 1)
        ColLayout.Parent = Column

        local function MakeText(Text, Order, Bold)
            local Label = InstanceNew("TextLabel")
            Label.LayoutOrder = Order
            Label.BackgroundTransparency = 1
            Label.Size = UDim2New(1, 0, 0, Bold and 18 or 15)
            Label.Text = Text
            Label.FontFace = Bold and GetBoldFontSafe() or Library.Font
            Label.TextSize = Bold and 15 or 13
            Label.TextColor3 = Library.Theme.Text
            Label.TextTransparency = 1
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.TextTruncate = Enum.TextTruncate.AtEnd
            Label.ZIndex = 1000002
            Library:AddToTheme(Label, {TextColor3 = "Text"})
            Label.Parent = Column
            Faders[#Faders + 1] = {Label, "TextTransparency", Bold and 0 or 0.45}
            return Label
        end
        local Labels = {MakeText(TitleText, SubAbove and 2 or 1, true)}
        if SubText then Labels[2] = MakeText(SubText, SubAbove and 1 or 2, false) end
        Faders[#Faders + 1] = {Pill, "BackgroundTransparency", 0.04}
        Faders[#Faders + 1] = {Stroke, "Transparency", 0.2}
        if IconLabel then Faders[#Faders + 1] = {IconLabel, "ImageTransparency", 0} end

        Slot.Parent = GetToastHolder(Position)

        -- size the pill to the text (measured once it is on screen), capped at TOAST_MAX_W
        local Widest = 0
        for _, Label in ipairs(Labels) do Widest = math.max(Widest, Label.TextBounds.X) end
        Widest = math.min(math.ceil(Widest) + 2, TextWidth)
        Column.Size = UDim2New(0, Widest, 0, SubText and 34 or 18)
        local PillWidth = PadLeft + (Image and (Side + 10) or 0) + Widest + 22
        Pill.Size = UDim2New(0, math.clamp(math.max(PillWidth, MinWidth), Height, TOAST_MAX_W), 0, Height)

        local function Fade(Visible, Time)
            local Info = TweenInfo.new(Time, Enum.EasingStyle.Quint, Visible and Enum.EasingDirection.Out or Enum.EasingDirection.In)
            for _, F in ipairs(Faders) do
                TweenService:Create(F[1], Info, {[F[2]] = Visible and F[3] or 1}):Play()
            end
            TweenService:Create(Pill, Info, {Position = UDim2New(0.5, 0, IsBottom and 1 or 0, Visible and 0 or (IsBottom and 14 or -14))}):Play()
        end

        local Toast = {}
        local Closed = false
        function Toast:Close()
            if Closed then return end
            Closed = true
            Fade(false, 0.25)
            task.delay(0.22, function()
                if not Slot.Parent then return end
                TweenService:Create(Slot, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {Size = UDim2New(1, 0, 0, 0)}):Play()
                task.delay(0.22, function()
                    Slot:Destroy()
                end)
            end)
        end

        TweenService:Create(Slot, TweenInfo.new(0.25, Enum.EasingStyle.Quint), {Size = UDim2New(1, 0, 0, Height)}):Play()
        Fade(true, 0.35)
        task.delay(Duration, function() Toast:Close() end)
        return Toast
    end

    -- name -> connection index: disconnecting is O(1) (it used to scan the whole list for every destroyed instance)
    local ConnectionByName = {}

    Library.Unload = function(self)
        for _, Value in pairs(self.Connections) do
            if Value.Connection then Value.Connection:Disconnect() end
        end
        TableClear(self.Connections)
        TableClear(ConnectionByName)
        for _, Value in pairs(self.Threads) do
            coroutine.close(Value)
        end
        TableClear(self.Threads)
        if self.Holder then
            self.Holder:Clean()
        end
        if self.UnusedHolder then
            self.UnusedHolder:Clean()
        end

        if self.ActiveInfoPopup then pcall(function() self.ActiveInfoPopup:Close() end) end
        for _, ActionName in ipairs(rawget(self, "BoundActions") or {}) do
            pcall(function() game:GetService("ContextActionService"):UnbindAction(ActionName) end)
        end

        TableClear(activeTweens)
        TableClear(self.ThemeItems)
        TableClear(self.ThemeMap)
        if getgenv().MidnightLibrary == self then getgenv().MidnightLibrary = nil end
        if getgenv().Library == self then getgenv().Library = nil end
        Library = nil
    end

    Library.Round = function(self, Number, Float)
        if not Float or Float <= 0 then
            return MathFloor(Number + 0.5)
        end
        local Multiplier = 1 / Float
        if Number < 0 then
            return -MathFloor(-Number * Multiplier + 0.5) / Multiplier
        end
        return MathFloor(Number * Multiplier + 0.5) / Multiplier
    end

    Library.Thread = function(self, Function)
        local NewThread = coroutine.create(Function)
        coroutine.wrap(function()
            coroutine.resume(NewThread)
        end)()
        TableInsert(self.Threads, NewThread)
        return NewThread
    end

    Library.SafeCall = function(self, Function, ...)
        if typeof(Function) == "function" then
            local Success, Result = pcall(Function, ...)
            if not Success then
                warn(Result)
                return false
            end
            return Success
        end
        return false
    end

    Library.QueueInitialCallback = function(self, Element, Callback, GetArgs)
        task.defer(function()
            if Element.Destroyed or Element.InitialCallbackFired then return end
            Element.InitialCallbackFired = true
            self:SafeCall(Callback, TableUnpack(GetArgs()))
        end)
    end

    Library.Connect = function(self, Event, Callback, Name)
        if not Event then return end
        self.UnnamedConnections = self.UnnamedConnections + 1
        -- the counter already guarantees a unique name (no GUID per connection)
        Name = Name or ("connection_number_" .. self.UnnamedConnections)

        local NewConnection = {
            Event = Event,
            Callback = Callback,
            Name = Name,
            Connection = nil
        }

        NewConnection.Connection = Event:Connect(Callback)
        TableInsert(self.Connections, NewConnection)
        NewConnection.Index = #self.Connections
        ConnectionByName[Name] = NewConnection
        return NewConnection
    end

    Library.Disconnect = function(self, Name)
        local Connection = ConnectionByName[Name]
        if not Connection then return end
        ConnectionByName[Name] = nil
        if Connection.Connection then Connection.Connection:Disconnect() end

        -- remove by swapping with the last item (connection order does not matter)
        local List, Index = self.Connections, Connection.Index
        if Index and List[Index] == Connection then
            local Last = List[#List]
            List[Index] = Last
            Last.Index = Index
            List[#List] = nil
        else
            local Found = TableFind(List, Connection)
            if Found then TableRemove(List, Found) end
        end
    end

    Library.NextFlag = function(self)
        self.UnnamedFlags = self.UnnamedFlags + 1
        local Flag = StringFormat("flag_number_%s_%s", self.UnnamedFlags, HttpService:GenerateGUID(false))
        self.AutoFlags[Flag] = true
        return Flag
    end

    -- remove an item from the theme list in O(1) (swap with the last; order does not matter)
    local function RemoveThemeData(self, ThemeData)
        local List, Index = self.ThemeItems, ThemeData.Index
        if Index and List[Index] == ThemeData then
            local Last = List[#List]
            List[Index] = Last
            Last.Index = Index
            List[#List] = nil
        end
        ThemeData.Index = nil
    end

    Library.AddToTheme = function(self, Item, Properties)
        Item = RawInstance(Item)

        local ThemeData = {
            Item = Item,
            Properties = Properties,
        }

        for Property, Value in pairs(ThemeData.Properties) do
            if type(Value) == "string" then
                Item[Property] = self.Theme[Value] or Value
            else
                Item[Property] = Value()
            end
        end

        TableInsert(self.ThemeItems, ThemeData)
        ThemeData.Index = #self.ThemeItems
        self.ThemeMap[Item] = ThemeData

        Item.Destroying:Connect(function()
            if self.ThemeMap[Item] == ThemeData then self.ThemeMap[Item] = nil end
            RemoveThemeData(self, ThemeData)
        end)
    end

    Library.ChangeItemTheme = function(self, Item, Properties)
        local Instance = RawInstance(Item)
        if not Instance or not Instance.Parent then return end

        local ThemeData = self.ThemeMap[Instance]
        if not ThemeData then
            ThemeData = { Item = Instance, Properties = {} }
            self.ThemeMap[Instance] = ThemeData
            TableInsert(self.ThemeItems, ThemeData)
            ThemeData.Index = #self.ThemeItems
        end

        for Property, Value in pairs(Properties) do
            ThemeData.Properties[Property] = Value
            if type(Value) == "string" then
                Instance[Property] = self.Theme[Value] or Value
            else
                local Ok, Result = pcall(Value)
                if Ok then Instance[Property] = Result end
            end
        end
    end

    Library.SetTheme = function(self, ThemeName)
        local NewTheme = Themes[ThemeName]
        if not NewTheme then
            warn("[MidnightLib] Theme not found: " .. tostring(ThemeName))
            return false
        end

        for Key, Color in pairs(NewTheme) do
            self.Theme[Key] = Color
        end

        -- reapply and compact the list in a single pass (items without a parent are dropped, as before)
        local Alive = {}
        for _, ThemeData in ipairs(self.ThemeItems) do
            local Item = ThemeData.Item

            if Item and Item.Parent then
                for Property, Value in pairs(ThemeData.Properties) do
                    if type(Value) == "string" then
                        Item[Property] = self.Theme[Value] or Value
                    else
                        local Ok, Result = pcall(Value)
                        if Ok then Item[Property] = Result end
                    end
                end
                Alive[#Alive + 1] = ThemeData
                ThemeData.Index = #Alive
            else
                if Item and self.ThemeMap[Item] == ThemeData then self.ThemeMap[Item] = nil end
                ThemeData.Index = nil
            end
        end
        self.ThemeItems = Alive

        self.CurrentTheme = ThemeName
        return true
    end

    Library.ToRich = function(self, Text, Color)
        return StringFormat('<font color="rgb(%s, %s, %s)">%s</font>', MathFloor(Color.R * 255), MathFloor(Color.G * 255), MathFloor(Color.B * 255), Text)
    end

    local autosavePending = false
    Library.SaveAutosave = function(self)
        if not writefile then return end
        if autosavePending then return end
        autosavePending = true
        task.delay(0.3, function()
            autosavePending = false
            pcall(function()
                local rawData = self:GetConfig()
                writefile("midnight_lib/autosave.json", rawData)
            end)
        end)
    end

    Library.GetConfig = function(self)
        local Config = {}
        Library:SafeCall(function()
            for Index, Value in pairs(Library.Flags) do
                if not Library.AutoFlags[Index] then
                    if type(Value) == "table" and Value.Key then
                        Config[Index] = {Key = tostring(Value.Key), Mode = Value.Mode}
                    elseif type(Value) == "table" and Value.Color then
                        Config[Index] = {Color = "#" .. Value.HexValue, Alpha = Value.Alpha}
                    else
                        Config[Index] = Value
                    end
                end
            end
        end)
        return HttpService:JSONEncode(Config)
    end

    Library.LoadConfig = function(self, Config)
        local ok, Decoded = pcall(HttpService.JSONDecode, HttpService, Config)
        if not ok or type(Decoded) ~= "table" then
            return false
        end

        for Index, Value in pairs(Decoded) do
            Library.PendingConfig[Index] = Value
        end

        local Success = Library:SafeCall(function()
            for Index, Value in pairs(Decoded) do
                local SetFunction = Library.SetFlags[Index]
                if SetFunction then
                    Library.PendingConfig[Index] = nil
                    if type(Value) == "table" and Value.Key then
                        SetFunction(Value)
                    elseif type(Value) == "table" and Value.Color then
                        SetFunction(Value.Color, Value.Alpha)
                    else
                        SetFunction(Value)
                    end
                end
            end
        end)
        return Success
    end

