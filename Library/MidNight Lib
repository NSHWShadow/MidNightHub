        local Info = TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        TweenService:Create(Backdrop, Info, {BackgroundTransparency = 0.45}):Play()
        TweenService:Create(Card, Info, {GroupTransparency = 0}):Play()
        TweenService:Create(CardScale, Info, {Scale = 1}):Play()
        return Dialog
    end

