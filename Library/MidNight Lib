            Button.AutoButtonColor = false
            Button.Position = UDim2New((Index - 1) / Count, (Index - 1) * Gap / Count, 0, 0)
            Button.Size = UDim2New(1 / Count, -Gap * (Count - 1) / Count, 1, -4)
