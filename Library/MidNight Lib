        for I, Dot in ipairs(P.Dots) do
            local On = I == self.Index
            Tween(Dot, 0.25, {Size = UDim2New(0, On and 16 or 6, 0, 6), BackgroundTransparency = On and 0 or 0.7, BackgroundColor3 = On and Color or Library.Theme.Text})
